# Hoolulu Firewall — Firecrawl Bot environment
# Copy this file to `.env` and fill in your key.

# Your Firecrawl API key (required to run the bot)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx

# Optional: override the Firecrawl API base URL
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# Optional: port for the server (default 3000)
PORT=3000

# Optional: factory name / environment
# AGENT_FACTORY_NAME=HooluluAgentFactory
# NODE_ENV=development
